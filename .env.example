NITRO_PORT=3000
# Default data folder: %LOCALAPPDATA%/Openfy/data
# OPENFY_DATA_DIR=D:/Music/Openfy
# Set this to the exact private HTTPS origin after enabling Tailscale Serve.
# OPENFY_ORIGIN=https://your-pc.your-tailnet.ts.net
# Optional alternative to the bundled FFmpeg:
# OPENFY_FFMPEG=C:/Tools/ffmpeg/bin/ffmpeg.exe
# Saved YouTube songs get their genre from the iTunes Search API (title, artist and album only).
# Set to off to never contact it.
# OPENFY_METADATA_LOOKUP=off
# Animated album covers for the desktop Big Picture come from Apple Music's web player (artist and album only).
# Set to off to never contact it; videos already stored keep working.
# OPENFY_MOTION_ART=off
# Apple Music storefront used to look albums up (two letters, default us).
# OPENFY_MOTION_STOREFRONT=mx
