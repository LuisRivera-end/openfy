<Application x:Class="Openfy.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="TrackCoverTemplate" xmlns:views="using:Openfy.Windows.Views"><views:TrackArtwork ArtworkUrl="{Binding Artwork}"/></DataTemplate>
    <SolidColorBrush x:Key="OpenfyGreen" Color="#1ED760"/>
    <SolidColorBrush x:Key="OpenfyBackground" Color="#09090B"/>
    <Color x:Key="SystemAccentColor">#1ED760</Color>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1ED760"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackground" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#6DED9A"/>
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#6DED9A"/>
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#09090B"/>
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
    <x:Double x:Key="SliderThumbThemeWidth">10</x:Double>
    <x:Double x:Key="SliderThumbThemeHeight">10</x:Double>
  </ResourceDictionary></Application.Resources>
</Application>
