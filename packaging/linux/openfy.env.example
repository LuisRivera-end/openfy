# Configuración de Openfy para Linux. Edita este archivo y reinicia el servicio:
#   systemctl --user restart openfy

# Puerto local (solo 127.0.0.1). Tailscale Serve publica este puerto en tu red privada.
NITRO_PORT=3000

# Carpeta de la biblioteca. Por defecto: ~/.local/share/openfy/data
# OPENFY_DATA_DIR=/srv/musica/openfy

# Dirección HTTPS exacta de Tailscale Serve. Es obligatoria para usar Openfy desde el teléfono.
# OPENFY_ORIGIN=https://tu-equipo.tu-tailnet.ts.net

# FFmpeg alternativo al incluido:
# OPENFY_FFMPEG=/usr/bin/ffmpeg

# Género de las canciones de YouTube guardadas (iTunes Search API). off para no consultarla nunca.
# OPENFY_METADATA_LOOKUP=off

# Portadas animadas (Apple Music). off para no consultarlas nunca.
# OPENFY_MOTION_ART=off
# OPENFY_MOTION_STOREFRONT=mx
