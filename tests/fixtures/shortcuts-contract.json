{
  "seekSeconds": 10,
  "volumeStep": 0.1,
  "cases": [
    { "name": "space toggles", "input": { "key": "Space" }, "command": "toggle-playback" },
    { "name": "k toggles", "input": { "key": "K" }, "command": "toggle-playback" },
    { "name": "ctrl right is next", "input": { "key": "ArrowRight", "ctrl": true }, "command": "next" },
    { "name": "ctrl left is previous", "input": { "key": "ArrowLeft", "ctrl": true }, "command": "previous" },
    { "name": "shift right seeks forward", "input": { "key": "ArrowRight", "shift": true }, "command": "seek-forward" },
    { "name": "shift left seeks backward", "input": { "key": "ArrowLeft", "shift": true }, "command": "seek-backward" },
    { "name": "ctrl up raises the volume", "input": { "key": "ArrowUp", "ctrl": true }, "command": "volume-up" },
    { "name": "ctrl down lowers the volume", "input": { "key": "ArrowDown", "ctrl": true }, "command": "volume-down" },
    { "name": "m mutes", "input": { "key": "M" }, "command": "mute" },
    { "name": "a shuffles", "input": { "key": "A" }, "command": "shuffle" },
    { "name": "r cycles repeat", "input": { "key": "R" }, "command": "repeat" },
    { "name": "f favorites", "input": { "key": "F" }, "command": "favorite" },
    { "name": "b opens big picture", "input": { "key": "B" }, "command": "big-picture" },
    { "name": "f11 opens big picture", "input": { "key": "F11" }, "command": "big-picture" },
    { "name": "c toggles the queue", "input": { "key": "C" }, "command": "queue" },
    { "name": "l toggles the lyrics", "input": { "key": "L" }, "command": "lyrics" },
    { "name": "ctrl k searches", "input": { "key": "K", "ctrl": true }, "command": "search" },
    { "name": "alt left goes back", "input": { "key": "ArrowLeft", "alt": true }, "command": "back" },
    { "name": "alt right goes forward", "input": { "key": "ArrowRight", "alt": true }, "command": "forward" },
    { "name": "browser back key", "input": { "key": "BrowserBack" }, "command": "back" },
    { "name": "browser forward key", "input": { "key": "BrowserForward" }, "command": "forward" },
    { "name": "mouse back button", "input": { "key": "MouseBack" }, "command": "back" },
    { "name": "mouse forward button", "input": { "key": "MouseForward" }, "command": "forward" },
    { "name": "escape closes", "input": { "key": "Escape" }, "command": "close" },
    { "name": "plain arrows stay with the focused control", "input": { "key": "ArrowLeft" }, "command": null },
    { "name": "alt up stays with the queue reorder", "input": { "key": "ArrowUp", "alt": true }, "command": null },
    { "name": "ctrl shift right is not next", "input": { "key": "ArrowRight", "ctrl": true, "shift": true }, "command": null },
    { "name": "shift m is not mute", "input": { "key": "M", "shift": true }, "command": null },
    { "name": "ctrl a stays select all", "input": { "key": "A", "ctrl": true }, "command": null },
    { "name": "ctrl r stays reload", "input": { "key": "R", "ctrl": true }, "command": null },
    { "name": "meta is never claimed", "input": { "key": "K", "meta": true }, "command": null },
    { "name": "letters type while editing", "input": { "key": "K", "editable": true }, "command": null },
    { "name": "space types while editing", "input": { "key": "Space", "editable": true }, "command": null },
    { "name": "ctrl arrows move by word while editing", "input": { "key": "ArrowRight", "ctrl": true, "editable": true }, "command": null },
    { "name": "escape belongs to the field while editing", "input": { "key": "Escape", "editable": true }, "command": null },
