{
  "releases": ["1.7.0", "1.6.0", "1.4.2", "1.4.0", "1.2.0", "1.1.0", "0.9.10", "0.9.2"],
  "cases": [
    { "name": "jump over several versions", "lastSeen": "1.1.0", "current": "1.7.0", "expected": ["1.7.0", "1.6.0", "1.4.2", "1.4.0", "1.2.0"] },
    { "name": "one version newer", "lastSeen": "1.6.0", "current": "1.7.0", "expected": ["1.7.0"] },
    { "name": "no history shows only the current version", "lastSeen": null, "current": "1.6.0", "expected": ["1.6.0"] },
    { "name": "invalid history counts as none", "lastSeen": "versión vieja", "current": "1.4.2", "expected": ["1.4.2"] },
    { "name": "no history and no entry for the current version", "lastSeen": null, "current": "1.5.0", "expected": [] },
    { "name": "same version shows nothing", "lastSeen": "1.7.0", "current": "1.7.0", "expected": [] },
    { "name": "downgrade shows nothing", "lastSeen": "1.7.0", "current": "1.4.0", "expected": [] },
    { "name": "versions without notes are skipped", "lastSeen": "1.2.0", "current": "1.5.0", "expected": ["1.4.2", "1.4.0"] },
    { "name": "lastSeen without its own entry", "lastSeen": "1.3.0", "current": "1.6.0", "expected": ["1.6.0", "1.4.2", "1.4.0"] },
    { "name": "numeric, not lexical, comparison", "lastSeen": "0.9.2", "current": "1.1.0", "expected": ["1.1.0", "0.9.10"] },
    { "name": "releases newer than the running app are ignored", "lastSeen": "1.2.0", "current": "1.4.0", "expected": ["1.4.0"] },
    { "name": "invalid current version shows nothing", "lastSeen": "1.1.0", "current": "1.7", "expected": [] }
  ]
}
